NODE_ENV=production
PORT=3003
LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@postgres:5432/shop_db
PG_POOL_MAX=20

AUTH_SERVICE_URL=http://auth-service:3001
BOOKING_SERVICE_URL=http://booking-service:3002

JWT_PUBLIC_KEY_PATH=/run/secrets/jwtRS256.key.pub
JWT_ISSUER=salon-platform.auth
JWT_AUDIENCE=salon-platform.api
CORS_ALLOWED_ORIGINS=https://your-web-app.example

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

RABBITMQ_URL=amqp://user:password@rabbitmq:5672
PAYOUT_ENCRYPTION_KEY=generate-32-byte-hex
